# Required: API key from the selected Datadog organization.
DD_API_KEY=replace-with-a-datadog-api-key

# Datadog site. Examples:
#   US1: datadoghq.com
#   US3: us3.datadoghq.com
#   US5: us5.datadoghq.com
#   EU1: datadoghq.eu
DD_SITE=us3.datadoghq.com

# Optional Datadog metadata.
DD_SOURCE=aiven
DD_TAGS=provider:aiven,env:production

# Optional static override. Leave empty to use each Aiven RFC5424 hostname as
# the Datadog service, which is recommended when forwarding several services.
DD_SERVICE=

# Optional listener/diagnostic settings.
SYSLOG_BIND_ADDRESS=0.0.0.0
SYSLOG_PORT=6514
MONITOR_PORT=24220
FLUENTD_LOG_LEVEL=info
